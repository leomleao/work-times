# Local development only. Production should prefer the *_FILE variants.
DATABASE_PATH=./data/work-times.sqlite
# WakaTime outbound OAuth client (create at https://wakatime.com/apps)
WAKATIME_OAUTH_CLIENT_ID=
WAKATIME_OAUTH_CLIENT_SECRET=
# Docker Compose example: /run/secrets/wakatime_oauth_client_secret
WAKATIME_OAUTH_CLIENT_SECRET_FILE=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Docker Compose example: /run/secrets/admin_password_hash
ADMIN_PASSWORD_HASH_FILE=
SESSION_SECRET=
# Docker Compose example: /run/secrets/session_secret
SESSION_SECRET_FILE=
PUBLIC_URL=http://localhost:3002
PORT=3002
HOST=127.0.0.1
COOKIE_SECURE=false
MAX_DIRECT_IMPORT_BYTES=100663296
